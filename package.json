{
  "name": "dsh-cross-collaboration",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "DSH cross-device LAN agent collaboration plugin: UDP discovery, identity summaries, and msg.post messaging between workspace main agents.",
  "main": "dist/host.js",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/queue-mock.cjs"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0",
    "ws": "^8.21.3"
  }
}
