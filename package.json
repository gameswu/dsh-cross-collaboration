{
  "name": "dsh-cross-collaboration",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "DSH cross-device LAN agent collaboration plugin: UDP discovery, identity summaries, and msg.post messaging between workspace main agents.",
  "main": "dist/host.js",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contract": "tsc -p tsconfig.contract.json --noEmit",
    "pretest": "node scripts/build.cjs",
    "test": "node --test scripts/queue-mock.cjs tests/host-dispose.test.cjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-workspace": "^0.1.2-alpha.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0",
    "ws": "^8.21.3"
  }
}
